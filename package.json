{
  "name": "@kytta/ngx-pipes",
  "version": "4.0.0",
  "author": "Dan Revah",
  "description": "Useful angular pipes",
  "license": "MIT",
  "scripts": {
    "start": "ng test",
    "test": "ng test --no-watch",
    "build": "ng build",
